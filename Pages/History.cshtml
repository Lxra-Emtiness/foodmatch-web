@page
@model FoodMatchWeb.Pages.HistoryModel

<div class="find-container">

    <div class="page-title">
        <h1>📜 History</h1>
        <p>ประวัติเมนูที่คุณเคยเลือก</p>
    </div>

    @if (Model.History.Count == 0)
    {
        <div class="no-result">

            <div style="font-size:60px;">
                🍽️
            </div>

            <h2>ยังไม่มีประวัติ</h2>

            <p>
                ลองค้นหาอาหารหรือสุ่มเมนูดูสิ
            </p>

            <a href="/FindFood" class="btn-primary">
                🍽️ หาอาหาร
            </a>

        </div>
    }
    else
    {
        <div class="results-section">

            <div class="history-header">

                <div>
                    <h2>🕘 เมนูที่เลือกไว้</h2>
                    <p>
                        ทั้งหมด @Model.History.Count รายการ
                    </p>
                </div>

                <form method="post"
                      asp-page-handler="Clear">

                    <button type="submit"
                            class="clear-history-button">
                        🗑️ ล้างทั้งหมด
                    </button>

                </form>

            </div>

            <div class="food-results">

                @foreach (var item in Model.History)
                {
                    <div class="food-result-card">

                        <div class="food-rank">
                            🕘
                        </div>

                        <div class="food-info">

                            <h3>
                                @item.Food.Name
                            </h3>

                            <p>
                                💰 @item.Food.Price บาท
                                · 🥩 @item.Food.Ingredient
                                · 🌶️ @item.Food.Taste
                            </p>

                            <p>
                                🍱 @item.Food.Type
                                · ⭐ @item.Food.Rating
                            </p>

                            <small class="history-time">
                                🗓️
                                @item.DateTime.ToString("dd/MM/yyyy HH:mm")
                            </small>

                        </div>

                        <form method="post"
                              asp-page-handler="Remove">

                            <input
                                type="hidden"
                                name="foodName"
                                value="@item.Food.Name" />

                            <button
                                type="submit"
                                class="favorite-remove">
                                🗑️
                            </button>

                        </form>

                    </div>
                }

            </div>

        </div>
    }

</div>